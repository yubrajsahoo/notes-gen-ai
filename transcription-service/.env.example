# Service Configuration
SERVICE_NAME=transcription-service
HOST=0.0.0.0
PORT=8082
LOG_LEVEL=INFO

# Faster-Whisper Configuration
# Model options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu          # Options: 'cpu' or 'cuda'
WHISPER_COMPUTE_TYPE=int8   # 'int8' for CPU, 'float16' for CUDA

# RabbitMQ Configuration (Port 5672)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
TRANSCRIPTION_EXCHANGE=notes.events.exchange
TRANSCRIPTION_ROUTING_KEY=transcription.completed

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,*
